FROM python:3.12.12-slim-bookworm@sha256:593bd06efe90efa80dc4eee3948be7c0fde4134606dd40d8dd8dbcade98e669c

ARG APP_UID=10001
ARG APP_GID=10001

RUN groupadd --gid ${APP_GID} downloader \
    && useradd --uid ${APP_UID} --gid ${APP_GID} --create-home \
       --home-dir /home/downloader --shell /usr/sbin/nologin downloader

COPY requirements-downloader.txt /tmp/requirements.txt
COPY scripts/verify_runtime_lock.py /tmp/verify_runtime_lock.py
RUN python -m pip install --no-cache-dir --disable-pip-version-check \
      --requirement /tmp/requirements.txt \
    && python /tmp/verify_runtime_lock.py /tmp/requirements.txt \
    && rm /tmp/requirements.txt /tmp/verify_runtime_lock.py

COPY --chown=${APP_UID}:${APP_GID} scripts/download_model.py /app/download_model.py

ENV HOME=/tmp \
    HF_HOME=/tmp/huggingface \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

USER ${APP_UID}:${APP_GID}
ENTRYPOINT ["python", "/app/download_model.py"]

